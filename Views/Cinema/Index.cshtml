@using _388.Extensions
@model List<_388.Models.Booking>

<!DOCTYPE html>
<html>
<head>
    <title>Cinema Ticket Booking</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: #151515;
            color: #f5f5f5;
        }

        .navbar-custom {
            background: #0d0d0d;
            border-bottom: 1px solid #c9a227;
        }

        .brand {
            color: #d4af37;
            font-size: 24px;
            font-weight: bold;
        }

        .hero {
            background: linear-gradient(135deg, #242424, #111111);
            border: 1px solid #3a3a3a;
            border-radius: 18px;
            padding: 35px;
            margin-top: 30px;
        }

        .hero h1 {
            color: #d4af37;
            font-weight: 700;
        }

        .hero p {
            color: #cfcfcf;
        }

        .btn-gold {
            background: #d4af37;
            color: #111;
            border: none;
            font-weight: 600;
        }

        .btn-gold:hover {
            background: #f0cc55;
            color: #111;
        }

        .btn-outline-gold {
            border: 1px solid #d4af37;
            color: #d4af37;
        }

        .btn-outline-gold:hover {
            background: #d4af37;
            color: #111;
        }

        .booking-card {
            background: #202020;
            border: 1px solid #333;
            border-radius: 14px;
            overflow: hidden;
        }

        .booking-card .card-header {
            background: #292929;
            color: #d4af37;
            border-bottom: 1px solid #3a3a3a;
        }

        .table {
            color: #f5f5f5;
            margin-bottom: 0;
        }

        .table thead {
            background: #292929;
            color: #d4af37;
        }

        .table td,
        .table th {
            border-color: #3a3a3a;
        }

        .table tbody tr:hover {
            background: #292929;
        }

        .price {
            color: #d4af37;
            font-weight: 600;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-custom">
    <div class="container">
        <span class="brand">🎬 CineBook</span>

        <div>
            <a asp-action="BookTicket"
               asp-controller="Cinema"
               class="btn btn-gold me-2">
                Book Ticket
            </a>

            <a asp-action="About"
               asp-controller="Cinema"
               class="btn btn-outline-gold">
                About
            </a>
        </div>
    </div>
</nav>

<div class="container">

    <div class="hero">
        <h1>Welcome to CineBook</h1>

        <p class="lead">
            Book your favourite movies and manage your cinema tickets easily.
        </p>

        <a asp-action="BookTicket"
           asp-controller="Cinema"
           class="btn btn-gold">
            🎟 Book Your Ticket
        </a>
    </div>

    <div class="booking-card mt-4 mb-5">

        <div class="card-header p-3">
            <h3 class="mb-0">Booked Tickets</h3>
        </div>

        <div class="card-body p-0">

            @if (Model.Count == 0)
            {
                <div class="alert alert-dark m-3">
                    No bookings available.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Movie</th>
                                <th>Show Date</th>
                                <th>Tickets</th>
                                <th>Status</th>
                                <th>Total Amount</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var booking in Model)
                        {
                            var movie = ((List<_388.Models.Movie>)ViewBag.Movies)
                                .FirstOrDefault(m => m.MovieId == booking.MovieId);

                            var status = booking.GetBookingStatus();

                            <tr>

                                <td>@booking.CustomerName</td>

                                <td>@movie?.MovieName</td>

                                <td>
                                    @booking.ShowDate.ToString("dd-MM-yyyy")
                                </td>

                                <td>@booking.NumberOfTickets</td>

                                <td>
                                    @if (status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else if (status == "Today")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Today
                                        </span>
                                    }
                                    else if (status == "Upcoming")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Upcoming
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Completed
                                        </span>
                                    }
                                </td>

                                <td class="price">
                                    @if (movie != null)
                                    {
                                        <span>
                                            ₹@booking.CalculateTotalAmount(movie)
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="MovieDetails"
                                       asp-controller="Cinema"
                                       asp-route-id="@booking.BookingId"
                                       class="btn btn-sm btn-outline-gold">
                                        Details
                                    </a>
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

</body>
</html>

