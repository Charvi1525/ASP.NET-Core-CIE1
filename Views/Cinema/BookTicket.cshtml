@model _388.Models.Booking

<!DOCTYPE html>
<html>
<head>
    <title>Book Movie Ticket</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: #151515;
            color: #f5f5f5;
        }

        .navbar-custom {
            background: #0d0d0d;
            border-bottom: 1px solid #d4af37;
        }

        .brand {
            color: #d4af37;
            font-size: 24px;
            font-weight: bold;
        }

        .booking-box {
            background: #202020;
            border: 1px solid #3a3a3a;
            border-radius: 18px;
            padding: 35px;
            margin-top: 35px;
            margin-bottom: 35px;
        }

        h1 {
            color: #d4af37;
            margin-bottom: 25px;
        }

        .form-label {
            color: #d4af37;
            font-weight: 500;
        }

        .form-control,
        .form-select {
            background: #292929;
            color: #ffffff;
            border: 1px solid #444;
        }

        .form-control:focus,
        .form-select:focus {
            background: #292929;
            color: #ffffff;
            border-color: #d4af37;
            box-shadow: 0 0 0 0.15rem rgba(212, 175, 55, 0.2);
        }

        .form-select option {
            background: #292929;
            color: white;
        }

        .btn-gold {
            background: #d4af37;
            color: #111;
            border: none;
            font-weight: 600;
        }

        .btn-gold:hover {
            background: #f0cc55;
            color: #111;
        }

        .btn-outline-gold {
            border: 1px solid #d4af37;
            color: #d4af37;
        }

        .btn-outline-gold:hover {
            background: #d4af37;
            color: #111;
        }

        .text-danger {
            color: #ff6b6b !important;
        }
    </style>
</head>

<body>

<nav class="navbar navbar-custom">
    <div class="container">

        <span class="brand">🎬 CineBook</span>

        <a asp-action="Index"
           asp-controller="Cinema"
           class="btn btn-outline-gold">
            Back to Bookings
        </a>

    </div>
</nav>

<div class="container">

    <div class="booking-box">

        <h1>🎟 Book Your Movie Ticket</h1>

        <form asp-action="BookTicket"
              asp-controller="Cinema"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="CustomerName"
                       class="form-label">
                    Customer Name
                </label>

                <input asp-for="CustomerName"
                       class="form-control"
                       placeholder="Enter your name">

                <span asp-validation-for="CustomerName"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       placeholder="Enter your email">

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Phone"
                       class="form-label">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="form-control"
                       placeholder="Enter phone number">

                <span asp-validation-for="Phone"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="MovieId"
                       class="form-label">
                    Select Movie
                </label>

                <select asp-for="MovieId"
                        class="form-select">

                    <option value="">
                        Select Movie
                    </option>

                    @foreach (var movie in (List<_388.Models.Movie>)ViewBag.Movies)
                    {
                        <option value="@movie.MovieId">
                            @movie.MovieId - @movie.MovieName - ₹@movie.TicketPrice
                        </option>
                    }

                </select>

                <span asp-validation-for="MovieId"
                      class="text-danger">
                </span>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="BookingDate"
                           class="form-label">
                        Booking Date
                    </label>

                    <input asp-for="BookingDate"
                           class="form-control"
                           type="date">

                    <span asp-validation-for="BookingDate"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="ShowDate"
                           class="form-label">
                        Show Date
                    </label>

                    <input asp-for="ShowDate"
                           class="form-control"
                           type="date">

                    <span asp-validation-for="ShowDate"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="mb-4">

                <label asp-for="NumberOfTickets"
                       class="form-label">
                    Number of Tickets
                </label>

                <input asp-for="NumberOfTickets"
                       class="form-control"
                       type="number"
                       min="1"
                       max="10"
                       placeholder="Enter number of tickets">

                <span asp-validation-for="NumberOfTickets"
                      class="text-danger">
                </span>

                <small class="text-secondary">
                    You can book 1 to 10 tickets.
                </small>

            </div>

            <button type="submit"
                    class="btn btn-gold">
                🎟 Book Ticket
            </button>

            <a asp-action="Index"
               asp-controller="Cinema"
               class="btn btn-outline-gold ms-2">
                Cancel
            </a>

        </form>

    </div>

</div>

</body>
</html>

